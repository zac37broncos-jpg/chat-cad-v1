{
  "name": "chad",
  "version": "0.1.0",
  "description": "CHAD: precision parametric CAD with an AI chat, for 3D printing",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "bench": "vitest run --config bench/vitest.config.ts",
    "smoke": "playwright test --config e2e/playwright.config.ts",
    "verify:print": "vitest run --config verify/vitest.config.ts && verify/print/.venv/bin/python verify/print/check_parts.py",
    "verify:print:export": "vitest run --config verify/vitest.config.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@salusoft89/planegcs": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  },
  "private": true,
  "type": "module"
}
